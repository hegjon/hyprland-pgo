prepare() {
	ln -sf hyprland-source "$_archive"
	cd "$_archive"
	# Release the EGL context before teardown; NVIDIA's EGL crashes on exit otherwise
	patch -Np1 --fuzz=0 -i "$srcdir/nvidia-egl-teardown.patch"
	# Destroying a wl_output global that clients may still be binding kills every client
	# when a dock's output flaps; wait before destroying it, as wlroots does
	patch -Np1 --fuzz=0 -i "$srcdir/wl-output-global-grace.patch"
	# A reload ignored a monitor rule's vrr unless something else about the rule changed
	patch -Np1 --fuzz=0 -i "$srcdir/monitor-rule-vrr.patch"
	sed -i -e '/^release:/{n;s/-D/-DCMAKE_SKIP_RPATH=ON -D/}' Makefile
	sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt
}

build() {
	cd "$_archive"
	_pgo_flags || return 1
	make release PREFIX=/usr
}

# Profile guided optimization (README.md, "PGO"), only when the environment asks for it; without these variables
# the build is the plain one:
#   PGO_GENERATE=DIR  the instrumented build: Hyprland, hyprctl, hyprpm and start-hyprland write their counters into DIR
#                     when they exit (DIR has to be writable by every user that runs them)
#   PGO_PROFILE=DIR   the build with the counters in DIR (several trainings merged with `gcov-tool merge`)
# GCC names the counter files after the object files' paths below $srcdir, but matches a function to its counters by
# a checksum that has the absolute path of its source in it: the build with a profile has to run in the same
# BUILDDIR as the training's build. A function changed since the training is compiled without its profile.
_pgo_flags() {
	local flags=() flag var
	if [[ -n ${PGO_GENERATE:-} && -n ${PGO_PROFILE:-} ]]; then
		error 'PGO_GENERATE and PGO_PROFILE are both set'
		return 1
	elif [[ -n ${PGO_GENERATE:-} ]]; then
		flags=("-fprofile-generate=$PGO_GENERATE" -fprofile-update=prefer-atomic "-fprofile-prefix-path=$srcdir")
	elif [[ -n ${PGO_PROFILE:-} ]]; then
		if [[ ! -d $PGO_PROFILE ]] || ! compgen -G "$PGO_PROFILE/*.gcda" >/dev/null; then
			error 'PGO_PROFILE has no counter files (*.gcda): %s' "$PGO_PROFILE"
			return 1
		fi
		# a stale profile (patches or sources changed since the training) costs the functions it no longer
		# matches their profile, it does not fail the build
		flags=("-fprofile-use=$PGO_PROFILE" -fprofile-correction -Wno-missing-profile
		       -Wno-error=coverage-mismatch "-fprofile-prefix-path=$srcdir")
	else
		return 0
	fi
	msg2 'PGO: %s' "${flags[*]}"
	# CMake takes the flags from the environment only when it configures a new build directory, and the training
	# and the build with its profile share BUILDDIR: no flags of the build before
	rm -rf build
	for flag in "${flags[@]}"; do
		for var in CFLAGS CXXFLAGS LDFLAGS; do
			printf -v "$var" '%s %s' "${!var}" "$flag"
		done
	done
	export CFLAGS CXXFLAGS LDFLAGS
}

package_hyprland() {
	depends+=(libEGL.so
	          libGLESv2.so
	          libaquamarine.so
	          libcanberra.so
	          libeis.so
	          libgio-2.0.so
	          libgobject-2.0.so
	          libhyprcursor.so
	          libhyprgraphics.so
	          libhyprlang.so
	          libhyprutils.so
	          libhyprwire.so
	          liblcms2.so
	          libpango-1.0.so
	          libpangocairo-1.0.so
	          libpixman-1.so
	          libre2.so
	          libreadline.so
	          libsdbus-c++.so
	          libtomlplusplus.so
	          libuuid.so
	          libwayland-server.so
	          libxkbcommon.so)
	cd "$_archive"
	make DESTDIR="$pkgdir" install
	rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
	find $pkgdir -name '*hyprpm*' -delete
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}

package_hyprpm() {
	pkgdesc='Plugin manager for Hyprland'
	depends=(cmake
	         cpio
	         glaze
	         hyprland
	         hyprland-protocols
	         hyprwayland-scanner
	         meson)
	cd "$_archive"
	make DESTDIR="$pkgdir" install
	find $pkgdir -type f,l -not -name '*hyprpm*' -delete
	find $pkgdir -type d -empty -delete
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
